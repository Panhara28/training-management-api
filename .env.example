PORT=8090
DATABASE_URL="mysql://user:password@localhost:3306/training_management_db?connection_limit=10"
JWT_SECRET="your-jwt-secret"
SESSION_SECRET="your-portal-session-secret"
CORS_ORIGIN="http://localhost:3000"
CORS_CREDENTIALS="true"
NODE_ENV=development

MOC_STORAGE_BASE_URL="https://mos.moc.gov.kh"
MOC_STORAGE_ACCESS_KEY="your-moc-storage-access-key"
MOC_STORAGE_SECRET_KEY="your-moc-storage-secret-key"
MOC_STORAGE_BUCKET_SLUG="your-moc-storage-bucket-slug"

# AAS (MOC OAuth) staff login. REDIRECT_URI is the frontend's /auth/callback page.
MOC_OAUTH_BASE_URL="https://mockey-api.moc.gov.kh"
MOC_OAUTH_CLIENT_ID="your-moc-oauth-client-id"
MOC_OAUTH_CLIENT_SECRET="your-moc-oauth-client-secret"
MOC_OAUTH_REDIRECT_URI="http://localhost:3000/auth/callback"

# Staff accounts that may also use the participant portal (comma-separated emails):
# signing in from the participant login page gives them a participant session,
# and they can register for trainings. Leave unset for nobody.
# PORTAL_STAFF_EMAILS="someone@moc.gov.kh"

# Enables demo-only helpers (fake analytics generator). Leave unset in production.
# ENABLE_DEMO_TOOLS="true"
